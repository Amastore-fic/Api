APP_NAME=CompraSegura
APP_URL=https://CAMBIA_ESTE_DOMINIO
APP_PORT=8002

APP_KEY=

# ---- Postgres ----
DB_DATABASE=comprasegura
DB_USERNAME=CAMBIA_ESTE_USUARIO
DB_PASSWORD=CAMBIA_ESTE_PASSWORD

# ---- MongoDB ----
# Obligatorias: docker-compose.prod.yml no arranca si faltan. Usa contrasenas sin
# caracteres especiales de URL (@ : / ? #), porque van dentro de MONGODB_URI.
MONGODB_DATABASE=comprasegura
MONGO_USERNAME=CAMBIA_ESTE_USUARIO
MONGO_PASSWORD=CAMBIA_ESTE_PASSWORD
MONGO_ROOT_USERNAME=CAMBIA_ESTE_USUARIO
MONGO_ROOT_PASSWORD=CAMBIA_ESTE_PASSWORD
BITACORA_DIAS_RETENCION=180

# ---- Tokens ----
SANCTUM_EXPIRATION=1440

# ---- Pasarela de pago (sandbox) ----
PASARELA_PAGO=simulada
PASARELA_SIMULADA_LIMITE_RECHAZO=50000
