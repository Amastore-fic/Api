APP_NAME=Amastore
APP_URL=https://CAMBIA_ESTE_DOMINIO
APP_PORT=8002

APP_KEY=

# Direccion publica de la tienda web (los correos enlazan ahi)
FRONTEND_URL=https://CAMBIA_ESTE_DOMINIO

# ---- Postgres ----
DB_DATABASE=comprasegura
DB_USERNAME=CAMBIA_ESTE_USUARIO
DB_PASSWORD=CAMBIA_ESTE_PASSWORD

# ---- MongoDB ----
# Obligatorias: docker-compose.prod.yml no arranca si faltan. Usa contrasenas sin
# caracteres especiales de URL (@ : / ? #), porque van dentro de MONGODB_URI.
MONGODB_DATABASE=comprasegura
MONGO_USERNAME=CAMBIA_ESTE_USUARIO
MONGO_PASSWORD=CAMBIA_ESTE_PASSWORD
MONGO_ROOT_USERNAME=CAMBIA_ESTE_USUARIO
MONGO_ROOT_PASSWORD=CAMBIA_ESTE_PASSWORD
BITACORA_DIAS_RETENCION=180

# ---- Redis (cache) ----
# Obligatoria: docker-compose.prod.yml no arranca si falta
REDIS_PASSWORD=CAMBIA_ESTE_PASSWORD

# ---- Correo (Gmail) ----
# Obligatorias: docker-compose.prod.yml no arranca si faltan.
# MAIL_PASSWORD es una contrasena de aplicacion de Google (16 letras, sin espacios),
# no la contrasena normal de la cuenta. El remitente debe ser la misma cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIA_ESTA_CUENTA@gmail.com
MAIL_PASSWORD=CAMBIA_ESTE_PASSWORD
MAIL_FROM_ADDRESS=CAMBIA_ESTA_CUENTA@gmail.com
MAIL_FROM_NAME=Amastore

# ---- Tokens ----
SANCTUM_EXPIRATION=1440

# ---- Pasarela de pago (sandbox) ----
PASARELA_PAGO=simulada
PASARELA_SIMULADA_LIMITE_RECHAZO=50000
