APP_NAME=CompraSegura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=comprasegura
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_FORWARD_PORT=5432

# ---- MongoDB (bitacora y datos sin relaciones) ----
# El usuario de la app se crea la primera vez que arranca el contenedor (docker/mongo/init-mongo.js)
MONGODB_DATABASE=comprasegura
MONGO_USERNAME=comprasegura
MONGO_PASSWORD=secret
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootsecret
MONGO_FORWARD_PORT=27017
# Milisegundos que la app espera a MongoDB antes de seguir sin el
MONGODB_TIMEOUT_MS=2000
# Dias que se conservan los registros de la bitacora (MongoDB los borra solo)
BITACORA_DIAS_RETENCION=180

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Minutos de vida del token de Sanctum (vacio = no expira)
SANCTUM_EXPIRATION=1440

# Pasarela de pago. En el MVP solo existe "simulada" (sandbox, sin dinero real).
PASARELA_PAGO=simulada
# Total a partir del cual la pasarela simulada rechaza el cobro (sirve para probar el flujo alterno)
PASARELA_SIMULADA_LIMITE_RECHAZO=50000

APP_PORT=8000

# Direccion de la tienda web: los correos (como el de recuperacion) enlazan ahi
FRONTEND_URL=http://localhost:5173
# Minutos que vale el enlace de recuperacion de contrasena
PASSWORD_RESET_EXPIRE=15

# "log": los correos no se envian, se escriben en storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@comprasegura.test"
MAIL_FROM_NAME="${APP_NAME}"
