# Lo que NO entra a la imagen de produccion (docker/php/Dockerfile hace COPY . .)

# Secretos: el .env se pasa como variables de entorno en docker-compose.prod.yml,
# nunca dentro de la imagen
.env
.env.*
!.env.example
!.env.production.example

# Dependencias: la imagen ejecuta su propio composer install --no-dev
vendor/
node_modules/

# Git, editores y CI
.git/
.gitlab-ci.yml
.idea/
.vscode/

# Archivos generados en tiempo de ejecucion (se conservan los .gitignore
# para que las carpetas existan dentro de la imagen)
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
bootstrap/cache/*.php
public/storage

# Pruebas
.phpunit.result.cache
.phpunit.cache/
